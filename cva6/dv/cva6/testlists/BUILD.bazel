exports_files(
    ["sim.sh"],
    visibility = ["//visibility:public"],
)

# ELF is rv64ima_zicsr (no F): its CRT emits no FP init, avoiding the
# unmapped-FP-write limitation (harness ties off rv_tester frd_*).
sh_test(
    name = "hello_world_cva6_verilator",
    srcs = ["//dv/cva6/testlists:sim.sh"],
    args = [
        "$(location //dv/cva6/verilator:cva6_tb_verilator)",
        "+load=$(location @rv_tester_common//testbins:hello_world.elf)",
        "+memmap_json_path=$(location @rv_tester_common//dv:memmap.json)",
        "+whisper_json_path=$(location @rv_tester_common//dv:whisper.json)",
        "+nomcm",
        "+eot=tohost",
        "+save_all_files",
    ],
    data = [
        "//dv/cva6/verilator:cva6_tb_verilator",
        "@rv_tester_common//dv:memmap.json",
        "@rv_tester_common//dv:whisper.json",
        "@rv_tester_common//testbins:hello_world.elf",
    ],
)

sh_test(
    name = "infinite_cva6_verilator",
    srcs = ["//dv/cva6/testlists:sim.sh"],
    args = [
        "$(location //dv/cva6/verilator:cva6_tb_verilator)",
        "+load=$(location @rv_tester_common//testbins:infinite.elf)",
        "+memmap_json_path=$(location @rv_tester_common//dv:memmap.json)",
        "+whisper_json_path=$(location @rv_tester_common//dv:whisper.json)",
        "+nostandalone",
        "+eot=max_instr",
        "+max_instr=8",
    ],
    data = [
        "//dv/cva6/verilator:cva6_tb_verilator",
        "@rv_tester_common//dv:memmap.json",
        "@rv_tester_common//dv:whisper.json",
        "@rv_tester_common//testbins:infinite.elf",
    ],
)

test_suite(
    name = "all_smoke",
    tests = [
        ":infinite_cva6_verilator",
        ":hello_world_cva6_verilator",
    ],
)
