# ELF is rv64ima_zicsr (no F): its CRT emits no FP init, avoiding the
# unmapped-FP-write limitation (harness ties off rv_tester frd_*).
sh_test(
    name = "hello_world_cva6_verilator",
    srcs = ["//common/dv:sim.sh"],
    args = [
        "$(location //cva6/dv/verilator:cva6_tb_verilator)",
        "+load=$(location //common/testbins:hello_world.elf)",
        "+memmap_json_path=$(location //common/dv:memmap.json)",
        "+whisper_json_path=$(location //common/dv:whisper.json)",
        "+nomcm",
        "+eot=tohost",
    ],
    data = [
        "//cva6/dv/verilator:cva6_tb_verilator",
        "//common/dv:memmap.json",
        "//common/dv:whisper.json",
        "//common/testbins:hello_world.elf",
    ],
)

sh_test(
    name = "infinite_cva6_verilator",
    srcs = ["//common/dv:sim.sh"],
    args = [
        "$(location //cva6/dv/verilator:cva6_tb_verilator)",
        "+load=$(location //common/testbins:infinite.elf)",
        "+memmap_json_path=$(location //common/dv:memmap.json)",
        "+whisper_json_path=$(location //common/dv:whisper.json)",
        "+nostandalone",
        "+eot=max_instr",
        "+max_instr=8",
    ],
    data = [
        "//cva6/dv/verilator:cva6_tb_verilator",
        "//common/dv:memmap.json",
        "//common/dv:whisper.json",
        "//common/testbins:infinite.elf",
    ],
)

test_suite(
    name = "all_smoke",
    tests = [
        ":infinite_cva6_verilator",
        ":hello_world_cva6_verilator",
    ],
)
