module(name = "cva6_with_rvtester", version = "0.0.0")

# rv_tester testbench; archive_override to patch external-dep declarations.
bazel_dep(name = "rv_tester", version = "0.0.0")

# Shared assets (test binaries, config, patches).
bazel_dep(name = "rv_tester_common", version = "0.0.0")
local_path_override(
    module_name = "rv_tester_common",
    path = "../common",
)

archive_override(
    module_name = "rv_tester",
    urls = ["https://github.com/tenstorrent/rv_tester/archive/298942848f32bc06a20d46e43d544e070709ff81.tar.gz"],
    strip_prefix = "rv_tester-298942848f32bc06a20d46e43d544e070709ff81",
    integrity = "sha256-KrGRoryLPqpT963WVd8q451HDF6BawHYQx/xHfAkGz4=",
)

# Toolchain deps: root-only overrides (child modules cannot override).
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_python", version = "0.40.0")
bazel_dep(name = "rules_cc", version = "0.0.9")
bazel_dep(name = "fmt", version = "9.1.0")

bazel_dep(name = "rules_verilator", version = "1.1.0")
bazel_dep(name = "rules_verilog", version = "1.1.0")

# Patch verilator process wrapper to propagate exit code.
single_version_override(
    module_name = "rules_verilator",
    version = "1.1.0",
    patches = ["//bazel:rules_verilator_propagate_exit.patch"],
    patch_strip = 1,
)
single_version_override(
    module_name = "verilator",
    version = "5.046",
)

bazel_dep(name = "whisper", version = "0.0.0")
git_override(
    module_name = "whisper",
    commit = "1edc51d170f06e461592d579be8c6f3e2b03d41a",
    remote = "https://github.com/tenstorrent/whisper",
)

# Root-only bazel_clang_tidy (referenced by .bazelrc).
bazel_dep(name = "bazel_clang_tidy", version = "0.0.0")
archive_override(
    module_name = "bazel_clang_tidy",
    urls = ["https://github.com/erenon/bazel_clang_tidy/archive/db677011c7363509a288a9fb3bf0a50830bbf791.tar.gz"],
    strip_prefix = "bazel_clang_tidy-db677011c7363509a288a9fb3bf0a50830bbf791",
    integrity = "sha256-cjoiSKMv0j33LPlj9Kf0BEBYy9wJoa1+jvZ/0WwHM0Y=",
)

# Python 3.9 (cvm/whisper requirement).
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.9",
)

verilator_ext = use_extension("@rules_verilator//:extensions.bzl", "verilator")
use_repo(verilator_ext, "verilator")

# Non-bzlmod externals; pins in rv_tester's extension.
rv_tester_external = use_extension("@rv_tester//bazel:external_deps_ext.bzl", "rv_tester_external_deps_ext")
use_repo(
    rv_tester_external,
    "CoreArchChecker",
    "cvm",
    "mem_manager",
    "opensrc-axi",
    "opensrc-nlohmann-json",
    "rules_hdl",
)
# Don't re-declare rv_tester_pypi/cvm_pypi here: pip hub names must be unique
# across modules (already declared by @rv_tester/@cvm).

cva6_ext = use_extension("//bazel:cva6_ext.bzl", "cva6_ext")
use_repo(cva6_ext, "cva6")
