module(name = "rv_tester_examples", version = "0.0.0")

# All deps for both examples, declared once. The *_override pins only take
# effect when this repo is the root module (its own dev/CI use); consumed as
# a bazel_dep of rv_tester's integration smoke they are ignored, and the
# dependency on "rv_tester" resolves to the consuming checkout. include() is
# not usable here: it is root-only, and this repo must stay dep-consumable.

bazel_dep(name = "rv_tester", version = "0.0.0")
archive_override(
    module_name = "rv_tester",
    urls = ["https://github.com/tenstorrent/rv_tester/archive/5475ea679d7bc5ba0580537ec1ba11db6b8f7fbc.tar.gz"],
    strip_prefix = "rv_tester-5475ea679d7bc5ba0580537ec1ba11db6b8f7fbc",
    integrity = "sha256-XXWwwfnLkfj/McvikMkz6UBx/zijPdFIs11Z+5pF5GY=",
)

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_python", version = "0.40.0")
bazel_dep(name = "rules_cc", version = "0.0.9")
bazel_dep(name = "fmt", version = "9.1.0")

bazel_dep(name = "rules_verilator", version = "1.1.0")
bazel_dep(name = "rules_verilog", version = "1.1.0")

# Propagate verilator's exit code.
single_version_override(
    module_name = "rules_verilator",
    version = "1.1.0",
    patches = ["//common/bazel:rules_verilator_propagate_exit.patch"],
    patch_strip = 1,
)
single_version_override(
    module_name = "verilator",
    version = "5.046",
)

bazel_dep(name = "whisper", version = "0.0.0")
git_override(
    module_name = "whisper",
    commit = "1edc51d170f06e461592d579be8c6f3e2b03d41a",
    remote = "https://github.com/tenstorrent/whisper",
)

# Referenced by .bazelrc clang-tidy aspect.
bazel_dep(name = "bazel_clang_tidy", version = "0.0.0")
archive_override(
    module_name = "bazel_clang_tidy",
    urls = ["https://github.com/erenon/bazel_clang_tidy/archive/db677011c7363509a288a9fb3bf0a50830bbf791.tar.gz"],
    strip_prefix = "bazel_clang_tidy-db677011c7363509a288a9fb3bf0a50830bbf791",
    integrity = "sha256-cjoiSKMv0j33LPlj9Kf0BEBYy9wJoa1+jvZ/0WwHM0Y=",
)

# cvm/whisper require 3.9.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.9",
)

# RiescueD's pypi deps. Own hub: rv_tester_pypi/cvm_pypi belong to rv_tester's
# pip.parse and hub names must be unique across modules.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "riescue_pypi",
    python_version = "3.9",
    requirements_lock = "//riescue_test_gen/bazel:requirements.txt",
)
use_repo(pip, "riescue_pypi")

# RiescueD framework + prebuilt RISC-V bare-metal GCC it compiles with.
riescue_ext = use_extension("//riescue_test_gen/bazel:riescue_ext.bzl", "riescue_ext")
use_repo(riescue_ext, "riescue", "riscv_none_elf_gcc")

# Non-bzlmod externals; pins in rv_tester's extension. Don't re-declare
# rv_tester_pypi/cvm_pypi: hub names must be unique across modules.
rv_tester_external = use_extension("@rv_tester//bazel:external_deps_ext.bzl", "rv_tester_external_deps_ext")
use_repo(
    rv_tester_external,
    "CoreArchChecker",
    "cvm",
    "mem_manager",
    "opensrc-axi",
    "opensrc-nlohmann-json",
    "rules_hdl",
)

cva6_ext = use_extension("//cva6/bazel:cva6_ext.bzl", "cva6_ext")
use_repo(cva6_ext, "cva6")

openc910_ext = use_extension("//openc910/bazel:openc910_ext.bzl", "openc910_ext")
use_repo(openc910_ext, "openc910")
