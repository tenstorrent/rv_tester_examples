load("@rules_verilator//verilator:defs.bzl", "verilator_cc_library")
load("@rules_hdl//verilog:providers.bzl", "verilog_library")
load("//openc910/dv:verilator_opts.bzl", "OPENC910_VOPTS")

verilog_library(
    name = "openc910_top",
    srcs = [
        "//openc910/dv:harness/top.sv",
        "//openc910/dv:harness/openc910_test_harness.sv",
    ],
    deps = [
        "//openc910/dv:openc910_rv_tester_sv",
        "@openc910//:openc910_core",
    ],
    top_module = "top",
)

verilator_cc_library(
    name = "openc910_tb_veri_lib",
    module = "openc910_top",
    trace_mode = "vcd",
    vopts = OPENC910_VOPTS,
)

cc_binary(
    name = "openc910_tb_verilator",
    srcs = ["@rv_tester//test/sw_testbench:sw_tb.cpp"],
    # Model built trace-capable; define VERILATOR_WAVES/VCD for dump code.
    copts = [
        "-DVERILATOR_WAVES",
        "-DVERILATOR_VCD",
    ],
    deps = [
        ":openc910_tb_veri_lib",
        "//openc910/dv:dpi_glue",
        "//openc910/dv:openc910_rv_tester_dpi",
        "@cvm//:logger",
        "@cvm//:topology",
        "@rules_verilator//verilator:verilated_runtime",
    ],
    visibility = ["//visibility:public"],
)
