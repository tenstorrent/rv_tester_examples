exports_files(
    ["sim.sh"],
    visibility = ["//visibility:public"],
)

# ELFs are linked at reset vector 0x80000000; harness drives pad_core0_rvba to match.

sh_test(
    name = "hello_world_openc910_verilator",
    srcs = ["//dv/openc910/testlists:sim.sh"],
    # C910 cosim is slow; generous timeout.
    timeout = "eternal",
    args = [
        "$(location //dv/openc910/verilator:openc910_tb_verilator)",
        "+load=$(location @rv_tester_common//testbins:hello_world.elf)",
        "+memmap_json_path=$(location @rv_tester_common//dv:memmap.json)",
        "+whisper_json_path=$(location @rv_tester_common//dv:whisper.json)",
        "+nomcm",
        "+eot=tohost",
        "+save_all_files",
    ],
    data = [
        "//dv/openc910/verilator:openc910_tb_verilator",
        "@rv_tester_common//dv:memmap.json",
        "@rv_tester_common//dv:whisper.json",
        "@rv_tester_common//testbins:hello_world.elf",
    ],
)

sh_test(
    name = "infinite_openc910_verilator",
    srcs = ["//dv/openc910/testlists:sim.sh"],
    timeout = "eternal",
    args = [
        "$(location //dv/openc910/verilator:openc910_tb_verilator)",
        "+load=$(location @rv_tester_common//testbins:infinite.elf)",
        "+memmap_json_path=$(location @rv_tester_common//dv:memmap.json)",
        "+whisper_json_path=$(location @rv_tester_common//dv:whisper.json)",
        "+nostandalone",
        "+eot=max_instr",
        "+max_instr=200",
    ],
    data = [
        "//dv/openc910/verilator:openc910_tb_verilator",
        "@rv_tester_common//dv:memmap.json",
        "@rv_tester_common//dv:whisper.json",
        "@rv_tester_common//testbins:infinite.elf",
    ],
)

test_suite(
    name = "all_smoke",
    tests = [
        ":infinite_openc910_verilator",
        ":hello_world_openc910_verilator",
    ],
)
